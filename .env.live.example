# LIMITLESS
LMTS_API_URL=https://api.limitless.exchange
LMTS_WS_URL=wss://ws.limitless.exchange
BASE_RPC_READ_ATTEMPTS=5
BASE_RPC_RETRY_MS=500

# BASE NETWORK
BASE_RPC_URL=https://mainnet.base.org
BASE_RPC_FALLBACK_URLS=

# LIMITLESS SCOPED HMAC TOKEN
LMTS_TOKEN_ID=
LMTS_TOKEN_SECRET=

# PRIVATE KEY OF THE SAME EOA REGISTERED WITH LIMITLESS
PRIVATE_KEY=

DRY_RUN=false
DRY_RUN_FILL_MODE=none
LIVE_TRADING_ACK=I_UNDERSTAND
LIVE_CANARY_ONLY=false



MAKER_MM_ASSETS=BTC,ETH,SOL
MAKER_MM_SUB_FREQUENCY=minutes_5
MAKER_MM_POLL_MS=5000
LMTS_DISCOVERY_REQUEST_GAP_MS=1000
LMTS_TIMELINE_NO_SLOT_BACKOFF_MS=300000
LMTS_MARKET_WS_MAX_SLUGS=18

# Prefer a current-market mined trade. If none appears, permit a midpoint
# only after three distinct size-filtered WS books have spread <= 0.10.
MAKER_MM_ENTRY_WINDOW_SEC=180
MAKER_MM_BOOK_WARMUP_MS=1500
MAKER_MM_BOOK_RETRY_MS=2000
MAKER_MM_BOOK_MAX_AGE_MS=5000
MAKER_MM_QUOTE_LOG_INTERVAL_MS=10000
LMTS_MARKET_ACTIVITY_POLL_MS=30000
MAKER_MM_REQUIRE_TRADE_FAIR=true
MAKER_MM_FAIR_TRADE_MAX_AGE_MS=60000
MAKER_MM_ALLOW_TIGHT_BOOK_FAIR=true
MAKER_MM_TIGHT_BOOK_MAX_SPREAD=0.10
MAKER_MM_TIGHT_BOOK_CONFIRMATIONS=3
MAKER_MM_OPENING_CANARY_FAIR=false
MAKER_MM_OPENING_FAIR_YES=0.500

MAKER_MM_PAPER_OBSERVE_SEC=120
MAKER_MM_PAPER_ACTIVITY_POLL_MS=10000
MAKER_MM_CUT_LOSS_SEC=30

# At 50 shares and combined 0.98: maximum cost $49, payout $50,
# gross $1 (2.0408%) only when all 50 YES and 50 NO shares settle.
MAKER_MM_SHARES=50
MAKER_MM_MAX_COMBINED=0.98
MAKER_MM_PRICE_TICK=0.001
MAKER_MM_JOIN_IMPROVEMENT_TICKS=1

MAKER_MM_FILL_TIMEOUT_SEC=30
MAKER_MM_SETTLEMENT_GRACE_SEC=30
MAKER_MM_SHUTDOWN_RECOVERY_TIMEOUT_SEC=180
MAKER_MM_BALANCE_POLL_MS=1500

MAKER_MM_REENTRY=false
MAKER_MM_REENTRY_DELAY_MS=1000
MAKER_MM_MAX_CYCLES_PER_MARKET=1

# One global $50 capital slot across all assets; stop after one-sided exposure.
MAKER_MM_MAX_LIVE_CYCLES_SESSION=12
MAKER_MM_MAX_CYCLE_USDC=50
MAKER_MM_MAX_TOTAL_USDC=50
MAKER_MM_STOP_SESSION_ON_ONE_SIDED=true
MAKER_MM_MIN_BASE_ETH=0.0002

MAKER_MM_UNWIND_SLIPPAGE_TICKS=3
MERGE_GAS_LIMIT=0
